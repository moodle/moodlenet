{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "preserve",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": true,
    "incremental": true,
    "paths": {
      "@moodle/bindings-http": ["bindings/http/src/index.ts"],
      "@moodle/domain": ["domain/src/index.ts"],
      "@moodle/domain/lib": ["domain/src/lib/index.ts"],
      "@moodle/domain/gate": ["domain/src/domain/gate/index.ts"],
      "@moodle/domain/core": ["domain/src/domain/core/index.ts"],
      "@moodle/domain/model": ["domain/src/domain/model/index.ts"],
      "@moodle/domain/core/setup": ["domain/src/domain/core/setup/index.ts"],
      "@moodle/lib-temp-dir": ["lib/temp-dir/src/index.ts"],
      "@moodle/lib-email-templates/org": ["lib/email-templates/src/moodle/index.ts"],
      "@moodle/lib-email-templates/user-account": ["lib/email-templates/src/moodle/user-account/index.ts"],
      "@moodle/lib-id-gen": ["lib/id-gen/src/index.ts"],
      "@moodle/lib-jwt-jose": ["lib/jwt/jose/src/index.ts"],
      "@moodle/lib-job-queue-service": ["lib/job-queue/service/src/index.ts"],
      "@moodle/lib-nodejs-common": ["lib/nodejs/common/src/index.ts"],
      "@moodle/lib-storage-local-fs": ["lib/storage/local-fs/src/index.ts"],
      "@moodle/lib-types": ["lib/types/src/index.ts"],
      "@moodle/sec-crypto-default": ["sec/crypto/default/src/index.ts"],
      "@moodle/sec-db-arango": ["sec/db/arango/src/index.ts"],
      "@moodle/sec-db-arango/dbUpgrade": ["sec/db/arango/src/dbUpgrade.ts"],
      "@moodle/sec-email-nodemailer": ["sec/email/nodemailer/src/index.ts"],
      "@moodle/sec-resource-ingestion-default": ["sec/resource-ingestion/default/src/index.ts"],
      "@moodle/sec-resource-metadata-generation-openai": ["sec/resource-metadata-generation/openai/src/index.ts"],
      "@moodle/sec-storage-local-fs": ["sec/storage/local-fs/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
